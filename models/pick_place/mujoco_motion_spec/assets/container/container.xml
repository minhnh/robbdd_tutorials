<mujoco model="container">
  <compiler meshdir="." angle="radian" autolimits="true"/>
  <default>
    <!-- The meshes provide appearance and mass; boxes preserve the hollow interior for contact. -->
    <geom density="600" friction="0.5 0.02 0.001" solref="0.005 1"
          contype="0" conaffinity="0"/>
    <default class="collision">
      <geom type="box" mass="0" group="3" rgba="0 1 0.25 0.35"
            contype="1" conaffinity="1"/>
    </default>
  </default>

  <asset>
    <mesh name="tray_body" file="tray_body.stl"
          scale="0.001 0.001 0.001" inertia="exact"/>
    <mesh name="tray_handle" file="tray_handle.stl"
          scale="0.001 0.001 0.001" inertia="exact"/>
    <material name="container" rgba="0.42 0.45 0.28 1"/>
  </asset>

  <worldbody>
    <!-- Root origin is the footprint center on the table surface. -->
    <body name="root">
      <geom type="mesh" mesh="tray_body" material="container"
            pos="-0.120 -0.100 0"/>
      <geom type="mesh" mesh="tray_handle" material="container"
            pos="-0.12 -0.1 -0.088" euler="1.5708 0 0"/>

      <geom name="floor" class="collision"
            pos="0 0 0.001" size="0.1174 0.100 0.001"/>
      <geom name="wall_left" class="collision"
            pos="-0.11625 0 0.03856" size="0.00115 0.100 0.03856"/>
      <geom name="wall_right" class="collision"
            pos="0.11625 0 0.03856" size="0.00115 0.100 0.03856"/>
      <geom name="wall_front" class="collision"
            pos="0 -0.0984 0.03995" size="0.120 0.0016 0.03995"/>
      <geom name="wall_back" class="collision"
            pos="0 0.0984 0.03856" size="0.1174 0.0016 0.03856"/>
      <geom name="handle" class="collision"
            pos="0.008 -0.120 0.040" size="0.010 0.0375 0.020"
            euler="1.5708 0 0" friction="1.2 0.05 0.005"/>
    </body>
  </worldbody>
</mujoco>
