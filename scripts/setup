#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
WS="$(cd -- "$REPO_DIR/../.." && pwd -P)"

usage() {
    cat <<'EOF'
Usage: scripts/setup [--build] [--install-system-packages] [mujoco|isaacsim-bt] [ros-distro]

The repository must be cloned as <workspace>/src/robbdd_tutorials.
Defaults: mujoco, jazzy. Isaac setup uses the minhnh fork fix/jazzy-asyncio-sleep branch.
ROBBDD_ISAAC_ROS_WS overrides the sibling NVIDIA ROS workspace path.
System package installation is optional; --build never prompts.
EOF
}

die() { printf 'setup: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing command: $1"; }

MODE=setup
INSTALL_SYSTEM_PACKAGES=prompt
while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --build) MODE=build ;;
        --install-system-packages) INSTALL_SYSTEM_PACKAGES=yes ;;
        --help) usage; exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
    shift
done
case "${1:-}" in -h) usage; exit 0 ;; esac
[ "$#" -le 2 ] || die "too many arguments"

CONTEXT="${1:-mujoco}"
ROS_DISTRO="${2:-${ROS_DISTRO:-jazzy}}"
case "$CONTEXT" in mujoco|isaacsim-bt) ;; *) die "unknown context: $CONTEXT" ;; esac
[[ "$ROS_DISTRO" =~ ^[a-z]+$ ]] || die "invalid ROS distribution: $ROS_DISTRO"
[ "$REPO_DIR" = "$WS/src/robbdd_tutorials" ] \
    || die "clone this repository as <workspace>/src/robbdd_tutorials"
[ -r "/opt/ros/$ROS_DISTRO/setup.bash" ] \
    || die "install ROS $ROS_DISTRO and configure its apt repository first"
ISAAC_ROS_WS="${ROBBDD_ISAAC_ROS_WS:-$WS/../IsaacSim-ros_workspaces/${ROS_DISTRO}_ws}"
# Keep generated shell files safe and resolve relative override paths consistently.
[[ "$WS$ISAAC_ROS_WS" != *"'"* && "$WS$ISAAC_ROS_WS" != *$'\n'* ]] \
    || die "workspace paths cannot contain quotes or newlines"
ISAAC_ROS_WS="$(realpath -m -- "$ISAAC_ROS_WS")"

install_system_packages() {
    [ "$MODE" = setup ] || return 0
    local packages=(git git-lfs build-essential cmake python3-vcs2l
                    python3-colcon-common-extensions python3-rosdep python3-venv)
    [ "$CONTEXT" != mujoco ] || packages+=(ant)
    local answer="$INSTALL_SYSTEM_PACKAGES"
    if [ "$answer" = prompt ] && [ ! -t 0 ]; then return 0; fi
    printf 'System prerequisites for %s:\n' "$CONTEXT"
    printf '  sudo apt install'; printf ' %q' "${packages[@]}"; printf '\n'
    if [ "$answer" = prompt ]; then
        read -r -p 'Install these packages? [y/N] ' answer || answer=no
    fi
    case "$answer" in y|Y|yes|YES) sudo apt install "${packages[@]}" ;; esac
}

install_system_packages
need git
need colcon
need rosdep
need vcs
[ "$CONTEXT" != mujoco ] || need ant

VENV="$WS/.venv"

source_file() {
    set +u
    # shellcheck disable=SC1090
    source "$1"
    set -u
}

install_python_packages() {
    local pip_cmd
    if command -v uv >/dev/null; then
        pip_cmd=(uv pip install --python "$VENV/bin/python")
    else
        "$VENV/bin/python" -m pip --version >/dev/null 2>&1 \
            || "$VENV/bin/python" -m ensurepip --upgrade
        pip_cmd=("$VENV/bin/python" -m pip install)
    fi
    local projects=(
        rdf-utils
        scene-dsl
        coord-dsl
        bdd-dsl
        robbdd
    )
    if [ "$CONTEXT" = mujoco ]; then
        projects+=(rec motion-spec-dsl motion-spec)
    fi

    # Install third-party requirements separately: several workspace projects
    # declare Git URLs for siblings, which conflicts with their editable paths
    # when uv resolves everything in one transaction.
    "${pip_cmd[@]}" \
        aiohttp behave click GitPython jinja2 numpy platformdirs protobuf \
        pyld pyshacl 'rdflib>=7.6.0' 'scipy>=1.16' textX textx-jinja \
        textx_ls_core trinary zstandard

    local project
    for project in "${projects[@]}"; do
        "${pip_cmd[@]}" --no-deps -e "$WS/pydeps/$project"
    done
}

setup_isaac_underlay() {
    local checkout ref=fix/jazzy-asyncio-sleep
    # Temporary gripper fix: https://github.com/isaac-sim/IsaacSim-ros_workspaces/issues/27
    checkout="$(dirname -- "$ISAAC_ROS_WS")"
    [ "${ISAAC_ROS_WS##*/}" = "${ROS_DISTRO}_ws" ] \
        || die "ROBBDD_ISAAC_ROS_WS must end in ${ROS_DISTRO}_ws"
    if [ ! -e "$checkout" ]; then
        [ "$MODE" = setup ] || die "NVIDIA checkout missing; run setup first"
        git clone --branch "$ref" --depth 1 \
            https://github.com/minhnh/IsaacSim-ros_workspaces.git "$checkout"
    fi
    [ "$(git -C "$checkout" rev-parse --show-toplevel)" = "$checkout" ] \
        || die "$checkout must be the NVIDIA repository root"
    if [ "$MODE" = setup ]; then
        [ -z "$(git -C "$checkout" status --porcelain)" ] \
            || die "NVIDIA checkout has local changes; resolve them before setup"
    fi
    [ "$(git -C "$checkout" branch --show-current)" = "$ref" ] \
        || die "NVIDIA checkout must use $ref from the minhnh fork; switch it explicitly (issue #27)"
    [ -d "$ISAAC_ROS_WS/src/moveit/isaac_moveit" ] \
        || die "Isaac fork does not provide the requested $ROS_DISTRO MoveIt workspace"
    git -C "$checkout" submodule update --init --recursive -- \
        "${ROS_DISTRO}_ws/src/moveit/moveit_resources" \
        "${ROS_DISTRO}_ws/src/moveit/topic_based_ros2_control"
    (
        cd "$ISAAC_ROS_WS"
        if [ "$MODE" = setup ]; then
            local paths=() selected
            selected="$(colcon list --base-paths src/moveit --packages-up-to isaac_moveit --paths-only)"
            [ -n "$selected" ] || die "no NVIDIA MoveIt packages found"
            mapfile -t paths <<< "$selected"
            rosdep install --from-paths "${paths[@]}" --ignore-src --rosdistro "$ROS_DISTRO" -y
        fi
        colcon build --base-paths src/moveit --packages-up-to isaac_moveit
    )
    source_file "$ISAAC_ROS_WS/install/local_setup.bash"
}

write_environment() {
    local ext="$1" shell_name="$2" shell_var="$3"
    local file="$WS/setup-robbdd-tutorials.$ext"
    local underlay=""
    [ "$CONTEXT" != isaacsim-bt ] || underlay="source '$ISAAC_ROS_WS/install/local_setup.$ext'"
    cat > "$file" <<EOF
# Generated by robbdd_tutorials/scripts/setup. Source this file.
if [ -z "\${$shell_var:-}" ]; then
    printf 'Use this environment from $shell_name: %s\\n' '$file' >&2
    return 2
fi
_robbdd_tutorial_had_nounset=0
[[ -o nounset ]] && _robbdd_tutorial_had_nounset=1
set +u
source '/opt/ros/$ROS_DISTRO/setup.$ext'
$underlay
source '$VENV/bin/activate'
source '$WS/install/local_setup.$ext'
source /usr/share/colcon_cd/function/colcon_cd.sh
cd '$WS'
colcon_cd --set
cd -
alias roscd=colcon_cd
[ "\$_robbdd_tutorial_had_nounset" -eq 1 ] && set -u || set +u
export ROBBDD_TUTORIAL_WS='$WS'
export ROBBDD_TUTORIAL_CONTEXT='$CONTEXT'
export ROBBDD_ISAAC_ROS_WS='$ISAAC_ROS_WS'
export BDD_TUTORIAL='$SCRIPT_DIR/bdd_tutorial'
export MOTION_SPEC_WS='$WS'
export MOTION_SPEC_GEN='$WS/generations'
export MOTION_SPEC_ENV='$file'
export MOTION_SPEC_PREFIX='$WS/install'
case ":\${PATH:-}:" in
    *":\$MOTION_SPEC_PREFIX/bin:"*) ;;
    *) export PATH="\$MOTION_SPEC_PREFIX/bin\${PATH:+:\$PATH}" ;;
esac
bdd_tutorial() { "\$BDD_TUTORIAL" "\$@"; }
printf 'RobBDD tutorial environment ready: %s\\n' '$WS'
unset _robbdd_tutorial_had_nounset
EOF
}

source_file "/opt/ros/$ROS_DISTRO/setup.bash"
if [ "$MODE" = setup ]; then
    [ -e /etc/ros/rosdep/sources.list.d/20-default.list ] \
        || die "initialize rosdep once with: sudo rosdep init"
    rosdep update --rosdistro "$ROS_DISTRO"
fi
[ "$CONTEXT" != isaacsim-bt ] || setup_isaac_underlay

if [ "$MODE" = setup ]; then
    cp "$REPO_DIR/colcon_defaults.yaml" "$WS/colcon_defaults.yaml"
    mkdir -p "$WS/pydeps" "$WS/generations"
    touch "$WS/pydeps/COLCON_IGNORE"
    touch "$WS/generations/COLCON_IGNORE"
    vcs import --recursive "$WS" < "$REPO_DIR/repos/common.repos"
    vcs import --recursive "$WS" < "$REPO_DIR/repos/$CONTEXT.repos"

    rosdep install --from-paths "$WS/src" --ignore-src --rosdistro "$ROS_DISTRO" -y \
        --skip-keys "catkin python3-future cmake_modules rosconsole roscpp rostest coord2b"

    if [ ! -e "$VENV/bin/activate" ]; then
        /usr/bin/python3 -m venv --system-site-packages "$VENV"
    elif ! grep -qx 'include-system-site-packages = true' "$VENV/pyvenv.cfg"; then
        die "$VENV was created without --system-site-packages; remove it and rerun setup"
    fi
else
    [ -e "$VENV/bin/activate" ] || die "run scripts/setup once before --build"
fi

source_file "$VENV/bin/activate"
install_python_packages

if [ "$CONTEXT" = mujoco ]; then
    motion-spec setup STSTv4 orocos_kinematics_dynamics coord2b mj_kdl_wrapper \
        --workspace "$WS" --ros
    [ ! -r "$WS/install/local_setup.bash" ] || source_file "$WS/install/local_setup.bash"
fi

cd "$WS"
if [ "$CONTEXT" = isaacsim-bt ]; then
    colcon build --packages-up-to robbdd_tutorials bdd_bt_executor_ros2
else
    colcon build
fi

write_environment bash Bash BASH_VERSION
write_environment zsh zsh ZSH_VERSION

printf '\nSetup complete. Source one of:\n'
printf '  source %s/setup-robbdd-tutorials.bash\n' "$WS"
printf '  source %s/setup-robbdd-tutorials.zsh\n' "$WS"
