#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
WS="$(cd -- "$REPO_DIR/../.." && pwd -P)"

usage() {
    cat <<'EOF'
Usage: scripts/setup [--build] [mujoco|isaacsim-bt] [ros-distro]

The repository must be cloned as <workspace>/src/robbdd_tutorials.
The default execution context is mujoco and the default ROS distro is jazzy.
EOF
}

die() { printf 'setup: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing command: $1"; }

MODE=setup
if [ "${1:-}" = --build ]; then
    MODE=build
    shift
fi
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

CONTEXT="${1:-mujoco}"
ROS_DISTRO="${2:-${ROS_DISTRO:-jazzy}}"
case "$CONTEXT" in mujoco|isaacsim-bt) ;; *) die "unknown context: $CONTEXT" ;; esac
[ "$REPO_DIR" = "$WS/src/robbdd_tutorials" ] \
    || die "clone this repository as <workspace>/src/robbdd_tutorials"
[ -r "/opt/ros/$ROS_DISTRO/setup.bash" ] \
    || die "ROS $ROS_DISTRO is not installed under /opt/ros"

need colcon
need ant
need rosdep
need uv
need vcs

VENV="$WS/.venv"

source_file() {
    set +u
    # shellcheck disable=SC1090
    source "$1"
    set -u
}

install_python_packages() {
    local projects=(
        rdf-utils
        scene-dsl
        coord-dsl
        bdd-dsl
        robbdd
    )
    if [ "$CONTEXT" = mujoco ]; then
        projects+=(rec motion-spec-dsl motion-spec)
    fi

    # Install third-party requirements separately: several workspace projects
    # declare Git URLs for siblings, which conflicts with their editable paths
    # when uv resolves everything in one transaction.
    uv pip install --python "$VENV/bin/python" \
        aiohttp behave click GitPython jinja2 numpy platformdirs protobuf \
        pyld pyshacl 'rdflib>=7.6.0' 'scipy>=1.16' textX textx-jinja \
        textx_ls_core trinary

    local project
    for project in "${projects[@]}"; do
        uv pip install --python "$VENV/bin/python" --no-deps -e "$WS/pydeps/$project"
    done
}

write_environment() {
    local ext="$1" shell_name="$2" shell_var="$3"
    local file="$WS/setup-robbdd-tutorials.$ext"
    cat > "$file" <<EOF
# Generated by robbdd_tutorials/scripts/setup. Source this file.
if [ -z "\${$shell_var:-}" ]; then
    printf 'Use this environment from $shell_name: %s\\n' '$file' >&2
    return 2
fi
_robbdd_tutorial_had_nounset=0
[[ -o nounset ]] && _robbdd_tutorial_had_nounset=1
set +u
source '/opt/ros/$ROS_DISTRO/setup.$ext'
source '$VENV/bin/activate'
source '$WS/install/local_setup.$ext'
[ "\$_robbdd_tutorial_had_nounset" -eq 1 ] && set -u || set +u
export ROBBDD_TUTORIAL_WS='$WS'
export ROBBDD_TUTORIAL_CONTEXT='$CONTEXT'
export BDD_TUTORIAL='$SCRIPT_DIR/bdd_tutorial'
export MOTION_SPEC_WS='$WS'
export MOTION_SPEC_GEN='$WS/generations'
export MOTION_SPEC_ENV='$file'
export MOTION_SPEC_PREFIX='$WS/install'
case ":\${PATH:-}:" in
    *":\$MOTION_SPEC_PREFIX/bin:"*) ;;
    *) export PATH="\$MOTION_SPEC_PREFIX/bin\${PATH:+:\$PATH}" ;;
esac
bdd_tutorial() { "\$BDD_TUTORIAL" "\$@"; }
printf 'RobBDD tutorial environment ready: %s\\n' '$WS'
unset _robbdd_tutorial_had_nounset
EOF
}

if [ "$MODE" = setup ]; then
    cp "$REPO_DIR/colcon_defaults.yaml" "$WS/colcon_defaults.yaml"
    mkdir -p "$WS/pydeps"
    vcs import "$WS" < "$REPO_DIR/repos/common.repos"
    vcs import "$WS" < "$REPO_DIR/repos/$CONTEXT.repos"

    rosdep update --rosdistro "$ROS_DISTRO"
    rosdep install --from-paths "$WS/src" --ignore-src --rosdistro "$ROS_DISTRO" -y \
        --skip-keys "catkin python3-future cmake_modules rosconsole roscpp rostest coord2b"

    if [ ! -e "$VENV/bin/activate" ]; then
        uv venv --python /usr/bin/python3 --system-site-packages "$VENV"
    elif ! grep -qx 'include-system-site-packages = true' "$VENV/pyvenv.cfg"; then
        die "$VENV was created without --system-site-packages; remove it and rerun setup"
    fi
else
    [ -e "$VENV/bin/activate" ] || die "run scripts/setup once before --build"
fi

source_file "/opt/ros/$ROS_DISTRO/setup.bash"
source_file "$VENV/bin/activate"
install_python_packages

if [ "$CONTEXT" = mujoco ]; then
    motion-spec setup stst orocos_kdl coord2b mj_kdl_wrapper \
        --workspace "$WS" --ros --no-dev --no-editable
    [ ! -r "$WS/install/local_setup.bash" ] || source_file "$WS/install/local_setup.bash"
fi

cd "$WS"
colcon build --base-paths "$WS/src"

write_environment bash Bash BASH_VERSION
write_environment zsh zsh ZSH_VERSION

printf '\nSetup complete. Source one of:\n'
printf '  source %s/setup-robbdd-tutorials.bash\n' "$WS"
printf '  source %s/setup-robbdd-tutorials.zsh\n' "$WS"
