#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
WS="${ROBBDD_TUTORIAL_WS:-$(cd -- "$REPO_DIR/../.." && pwd -P)}"

usage() {
    cat <<'EOF'
Usage: bdd_tutorial <command>

  pull    Pull src/ and pydeps/; fetch the pinned NVIDIA checkout without changing its version.
  build   Reinstall local Python packages and rebuild the ROS workspace.
  source  Print the environment file for the current login shell.
EOF
}

case "${1:-}" in
    pull)
        vcs pull "$WS/src"
        vcs pull "$WS/pydeps"
        if [ "${ROBBDD_TUTORIAL_CONTEXT:-mujoco}" = isaacsim-bt ]; then
            : "${ROBBDD_ISAAC_ROS_WS:?source the generated tutorial environment first}"
            git -C "$(dirname -- "$ROBBDD_ISAAC_ROS_WS")" fetch origin
        fi
        ;;
    build)
        exec "$SCRIPT_DIR/setup" --build \
            "${ROBBDD_TUTORIAL_CONTEXT:-mujoco}" "${ROS_DISTRO:-jazzy}" \
            "${ROBBDD_ISAACSIM_VERSION:-6.1.0}"
        ;;
    source)
        case "${SHELL##*/}" in zsh) ext=zsh ;; *) ext=bash ;; esac
        printf '%s/setup-robbdd-tutorials.%s\n' "$WS" "$ext"
        ;;
    -h|--help|help|'') usage ;;
    *) printf 'bdd_tutorial: unknown command: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac
