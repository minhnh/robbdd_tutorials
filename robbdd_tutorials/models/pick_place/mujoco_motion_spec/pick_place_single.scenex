import "../common/pick_place_single.scene"
import "scene_dsl:robots/kinova_gen3_7dof.ktree"
import "scene_dsl:robots/robotiq_2f85.ktree"

ns pps_mjc = "https://secorolab.github.io/models/scenes/pick-place-single-mjc/"

// Each object draws independently, above the tallest object's bottom offset.
// Gravity settles the objects on the table; initial overlaps are not rejected.
distrib (ns=pps_mjc) object-position {
    uniform { dimension: 3 lower: (0.30, -0.30, 0.15) upper: (0.65, -0.05, 0.20) }
}

ktree inst (ns=pps_mjc) kinova of <kinova_tree>
ktree inst (ns=pps_mjc) gripper of <gripper_tree>

ktree (ns=pps_mjc) kinova_2f85 {
    root: <kinova.base_link.base_link_origin>
    tree <kinova>
    tree <gripper>

    joints {
        fixed gripper_on_pinch_site {
            parent: <kinova.bracelet_link.pinch_site>
            child: <gripper.g_base_mount.g_mount_interface>
        }
        serial {
            root: <kinova.base_link.base_link_origin>
            tip: <gripper.g_base.g_pinch>
        }
    }
}

ktree (ns=pps_mjc) world_tree {
    root: <world_body.world>
    tree <kinova_2f85>

    body world_body {
        frame world { }
    }

    body table {
        frame table_top {
            pose table_top_in_world {
                wrt: <world_body.world>
                xyz: (0.0, 0.0, 0.72) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        frame table_observation_point {
            pose table_observation_point_in_table {
                wrt: <table.table_top>
                xyz: (0.50, 0.0, 0.04) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        // table.xml states no <inertial>: MuJoCo derives these from the top and leg geoms.
        frame table_com {
            pose table_com_in_table_top {
                wrt: <table.table_top>
                xyz: (0.0, 0.0, -0.066871347710129106) m
                orientation: quat {
                    xyzw: (0.7071067811865489, 0.0, 0.7071067811865489, 0.0)
                }
            }
        }
        inertia {
            frame: <table_com>
            mass: 59.116813487046294 kg
            inertia-matrix: (
                (19.434586382248881, 0.0, 0.0),
                (0.0, 16.788357767857562, 0.0),
                (0.0, 0.0, 4.9862908177644591)
            ) kg*m^2
        }
    }

    body container {
        frame container_origin {
            pose container_on_table {
                wrt: <table.table_top>
                xyz: (0.40, 0.24, 0.0) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        frame bin_observation_point {
            pose bin_observation_point_in_container {
                wrt: <container.container_origin>
                xyz: (0.0, 0.0, 0.03) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        frame container_com {
            pose container_com_in_origin {
                wrt: <container.container_origin>
                xyz: (0.000025, -0.023302, 0.028773) m
                orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
            }
        }
        inertia {
            frame: <container_com>
            mass: 0.350 kg
            inertia-matrix: (
                (0.002839864, 0.000000373, 0.000000416),
                (0.000000373, 0.002233384, 0.000103658),
                (0.000000416, 0.000103658, 0.004655829)
            ) kg*m^2
        }
    }

    joints {
        fixed table_on_world {
            parent: <world_body.world>
            child: <table.table_top>
        }
        fixed arm_on_table {
            parent: <table.table_top>
            child: <kinova.base_link.base_link_origin>
        }
        fixed container_on_table {
            parent: <table.table_top>
            child: <container.container_origin>
        }
    }
}

scene inst (ns=pps_mjc) pick_place_scene_mjc {
    scene: <pick_place_scene>

    kgraph (ns=pps_mjc) pick_place_graph {
        anchor: <world_tree.world_body.world>
        tree <world_tree>

        body cube {
            frame cube_origin {
                pose cube_on_table {
                    wrt: <world_tree.table.table_top>
                    xyz: sample <object-position> m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
                }
            }
        }
        body can {
            frame can_origin {
                pose can_on_table {
                    wrt: <world_tree.table.table_top>
                    xyz: sample <object-position> m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
                }
            }
        }

        body cereal-box {
            frame cereal-box_origin {
                pose cereal-box_on_table {
                    wrt: <world_tree.table.table_top>
                    xyz: sample <object-position> m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
                }
            }
        }

        body bottle {
            frame bottle_origin {
                pose bottle_on_table {
                    wrt: <world_tree.table.table_top>
                    xyz: sample <object-position> m
                    orientation: euler { axes: xyz extrinsic angles: (0, 0, 0) unit: deg }
                }
            }
        }

    }

    obj <ws_objects.table> {
        model table-mjc as mjcf { sys path = 'assets/table/table.xml'
            map body <world_tree.table> to "table"
        }
    }

    obj <ws_objects.bin> {
        model container-mjc as mjcf {
            sys path = 'assets/container/container.xml'
            map body <world_tree.container> to "container"
        }
    }

    obj <pickplace_objects.cube> {
        model cube-mjc as mjcf { sys path = 'src/mj_kdl_wrapper/assets/cube.xml'
            map body <pick_place_graph.cube> to "cube"
        }
    }

    obj <pickplace_objects.can> {
        model can-mjc as mjcf {
            sys path = 'assets/robosuite/objects/can.xml'
            map body <pick_place_graph.can> to "can"
        }
    }

    obj <pickplace_objects.cereal-box> {
        model cereal-box-mjc as mjcf {
            sys path = 'assets/robosuite/objects/cereal.xml'
            map body <pick_place_graph.cereal-box> to "cereal-box"
        }
    }

    obj <pickplace_objects.bottle> {
        model bottle-mjc as mjcf {
            sys path = 'assets/robosuite/objects/bottle.xml'
            map body <pick_place_graph.bottle> to "bottle"
        }
    }

    agn <pickplace_agents.arm1> {
        model kinova-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/kinova_gen3/gen3.xml'
            map tree <kinova> to "base_link"
        }

        camera wrist {
            frame: <kinova.bracelet_link.wrist_anchor>
            type: rgb
            resolution: (640, 480)
            fov: 41.83792730009236 deg
            update-rate: 30.0 Hz
        }
    }

    agn <pickplace_agents.gripper1> {
        model gripper-mjc as mjcf {
            sys path = 'src/mj_kdl_wrapper/assets/robotiq_2f85/2f85.xml'
            map tree <gripper> to "base_mount"
        }
    }
}
