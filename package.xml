<?xml version="1.0"?>
<package format="3">
  <name>robbdd_tutorials</name>
  <version>0.1.0</version>
  <description>Models and launch files for the RobBDD tutorials.</description>
  <maintainer email="1168534+minhnh@users.noreply.github.com">Minh Nguyen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">bdd_bt_executor_ros2</exec_depend>
  <test_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">bdd_bt_executor_ros2</test_depend>
  <exec_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">launch_xml</exec_depend>
  <exec_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">isaac_moveit</exec_depend>
  <exec_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">moveit_resources_panda_moveit_config</exec_depend>
  <exec_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">moveit_ros_move_group</exec_depend>
  <exec_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">robot_state_publisher</exec_depend>
  <exec_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">controller_manager</exec_depend>
  <exec_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">rviz2</exec_depend>
  <exec_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">xacro</exec_depend>
  <test_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">ament_cmake_gtest</test_depend>
  <test_depend condition="$ROBBDD_TUTORIAL_CONTEXT == 'isaacsim-bt'">ament_cmake_pytest</test_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>bdd_exec_ros2</exec_depend>
  <exec_depend>bdd_ros2_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
